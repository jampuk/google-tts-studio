# ─────────────────────────────────────────────────────────────────────────────
# Git Attributes — google-tts-studio
# ─────────────────────────────────────────────────────────────────────────────

# Default: normalise all line endings to LF in the repo, checkout as LF
* text=auto eol=lf

# Explicitly text files
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sh        text eol=lf

# Windows scripts — keep CRLF when checked out on Windows
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — never diff or merge these
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp3       binary
*.wav       binary
*.ogg       binary

# Mark generated / lockfiles as not diffable
poetry.lock  linguist-generated=true
