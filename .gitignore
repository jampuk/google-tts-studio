# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — google-tts-studio
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
*-credentials.json

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── Agent / AI instruction files ─────────────────────────────────────────────
agents.md
AGENTS.md

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Local overrides for compose (never commit secrets)
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Generated audio output (local testing artefacts) ─────────────────────────
*.mp3
*.wav
*.ogg
*.au
*.alaw

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
